# Android Studio normally writes the local SDK path into local.properties.
# Example (do not copy this path literally):
# sdk.dir=/Users/your-name/Library/Android/sdk

# Android emulator reaches the backend on the host through 10.0.2.2.
BACKEND_BASE_URL=http://10.0.2.2:8080/

# For a physical phone, use the Mac's LAN address, for example:
# BACKEND_BASE_URL=http://192.168.1.25:8080/

# Values can also be supplied without editing this file:
# BACKEND_BASE_URL=https://api.example.com ./gradlew assembleRelease
# ./gradlew -PBACKEND_BASE_URL=https://api.example.com assembleRelease
