# Kopirati u .env.production na serveru (ne ide u Git) i popuniti.
# Lozinka i ključ: dugačke nasumične vrednosti, npr. `openssl rand -hex 32`.

# Adresa servera (DNS mora da pokazuje na IP servera), npr. besplatan
# poddomen sa duckdns.org.
APP_DOMAIN=ime.duckdns.org

POSTGRES_DB=pametna_kupovina
POSTGRES_USER=pametna_kupovina
POSTGRES_PASSWORD=zameni_dugom_nasumicnom_lozinkom

# Ključ za administratorske putanje i stranicu /admin.
ADMIN_API_KEY=zameni_drugim_dugim_nasumicnim_kljucem
SHOPPING_MAX_PRICE_AGE_DAYS=30

# Memorija za Oracle Always Free ARM (12 GB RAM). Oracle može da ugasi
# besplatnu mašinu kojoj su 7 dana procesor, mreža i memorija ispod 20%;
# Java koja odmah zauzme 3 GB drži memoriju iznad toga.
# Na mašini sa 4 GB RAM-a (npr. Hetzner CX23) staviti:
#   BACKEND_JAVA_OPTIONS=-Xms512m -Xmx2g
#   POSTGRES_SHARED_BUFFERS=512MB
#   POSTGRES_EFFECTIVE_CACHE_SIZE=1500MB
BACKEND_JAVA_OPTIONS=-Xms3g -Xmx4g -XX:+AlwaysPreTouch
POSTGRES_SHARED_BUFFERS=2GB
POSTGRES_EFFECTIVE_CACHE_SIZE=6GB

# ops/backup.sh: koliko dana se čuvaju dump-ovi na serveru i originalni
# cenovnici. BACKUP_UPLOAD_URL je Oracle Object Storage pre-authenticated
# request sa pravom upisa (završava se sa /o/); prazno = bez slanja van servera.
BACKUP_KEEP_DAYS=14
IMPORT_ARCHIVE_KEEP_DAYS=30
BACKUP_UPLOAD_URL=

# ops/check-import.sh: adresa na koju ide kratka poruka kad dnevni uvoz ne
# uspe ili server ne odgovara, npr. ntfy tema https://ntfy.sh/<dugo-tajno-ime>.
# Prazno = poruka samo u izlazu skripte.
ALERT_URL=
