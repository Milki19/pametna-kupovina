APP_DOMAIN=api.example.com

POSTGRES_DB=pametna_kupovina
POSTGRES_USER=pametna_kupovina
POSTGRES_PASSWORD=replace_with_a_long_random_password

ADMIN_API_KEY=replace_with_a_different_long_random_secret
SHOPPING_MAX_PRICE_AGE_DAYS=30

PRICE_IMPORT_SCHEDULE_ENABLED=true
# Worker je zaseban servis; uključivanjem ove vrednosti obuhvata sve trenutno
# registrovane državne CSV izvore navedene ispod.
PRICE_IMPORT_SCHEDULE_RETAILERS=EUROPROM,LIDL,IDEA_RODA,UNIVEREXPORT,DIS
PRICE_IMPORT_SCHEDULE_CRON=0 0 3 * * *

MAXI_PRICE_IMPORT_SCHEDULE_ENABLED=true
MAXI_PRICE_IMPORT_SCHEDULE_CRON=0 0 4 * * *
MAXI_PRICE_IMPORT_STORE_CODES=508,538,512,513,541,544
MAXI_PRICE_IMPORT_STORE_FILE_PREFIXES=508=MAXI_508_KNEZA_MIHAJLA_84_86_VALJEVO_,538=MAXI_538_KARADJORDJEVA_92_VALJEVO_,512=PRODAVNICA_512_OBRENA_NIKOLICA_3_VALJEVO_,513=PRODAVNICA_513_NASELJE_ZBRATIMLJENI_GRADOVI_BB_VALJEVO_,541=MAXI_541_GODJEVACKA_2_DIVCIBARE_VALJEVO_,544=MAXI_544_KARADJORDJEVA_2_VALJEVO_
MAXI_PRICE_IMPORT_STORE_LOCATION_CODES=508=S841,538=S538,512=S512,513=S513,541=S541,544=S927
MAXI_PRICE_IMPORT_LOOKBACK_DAYS=7

# Nedeljno osvežava zvanične lokatore svih podržanih lanaca. Lokacije bez
# potvrđene cenovničke zone ostaju vidljive, ali ne ulaze u preporuku.
VERIFIED_LOCATION_IMPORT_SCHEDULE_ENABLED=true
VERIFIED_LOCATION_IMPORT_SCHEDULE_CRON=0 0 2 * * SUN
DIS_LOCATION_IMPORT_URL=https://www.dis.rs/api/Dis/Locations
EUROPROM_LOCATION_IMPORT_URL=https://europrom.rs/prodajni-objekti/
MAXI_LOCATION_IMPORT_GRAPHQL_URL=https://www.maxi.rs/api/v1/
IDEA_LOCATION_IMPORT_URL=https://www.idea.rs/layout/set/json/Prodavnice
RODA_LOCATION_IMPORT_URL=https://roda.rs/roda-prodavnice--p-1
IDEA_PRICE_FORMAT_MAPPING_DISCOVERY_URL=https://data.gov.rs/sr/datasets/cenovnici-proizvoda-prema-pravilniku-o-uslovima-sadrzaju-i-nacinu-objavljivanja-cenovnika-idea-marketi-doo/
IDEA_PRICE_FORMAT_MAPPING_MAX_DOWNLOAD_BYTES=10000000
UNIVEREXPORT_LOCATION_IMPORT_URL=https://www.univerexport.rs/api/fetch/fetchProdavnice
# Javni browser ključ iz zvaničnog Lidl lokatora; zameniti ako ga Lidl promeni.
LIDL_LOCATION_IMPORT_API_KEY=16QaHsGX3Uc3JLhNlS2ZG1CmosbzVPs2

DATA_QUALITY_MONITOR_ENABLED=true
DATA_QUALITY_MONITOR_INTERVAL_MS=3600000
DATA_QUALITY_STALE_PRICE_DAYS=2

JVM_TOOL_OPTIONS=-Xms256m -Xmx1536m
IMPORT_WORKER_JVM_TOOL_OPTIONS=-Xms256m -Xmx2048m
PRICE_IMPORT_WORKER_INSTANCE_ID=import-worker-1
